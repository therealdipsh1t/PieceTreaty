# ── Deployer wallet (Hardhat) ──────────────────────────
# Export a funded testnet key. NEVER commit real keys.
PRIVATE_KEY=0xyour_private_key_here

# Optional RPC overrides
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC=https://rpc.monad.xyz

# First series created on deploy (set CREATE_FIRST_SERIES=false to skip)
CREATE_FIRST_SERIES=true
SERIES_NAME=Series 1 - Classics
SERIES_BASE_URI=http://localhost:5173/metadata/series-1/json/
SERIES_MAX_SUPPLY=1000
SERIES_MINT_PRICE=0.1
SERIES_MAX_PER_WALLET=5
SERIES_ACTIVE=true

# ── Web dashboard (copy values into web/.env) ──────────
# VITE_NFT_ADDRESS=0x...
# VITE_NFT_CHAIN_ID=10143
# VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_cloud_id
# VITE_MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz

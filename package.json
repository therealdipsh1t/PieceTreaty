{
  "name": "legally-mime-nft",
  "private": true,
  "version": "1.0.0",
  "description": "Legally Mime multi-series NFT on Monad + mint dashboard",
  "scripts": {
    "contracts:install": "npm install --prefix contracts",
    "contracts:compile": "npm run compile --prefix contracts",
    "contracts:test": "npm test --prefix contracts",
    "web:install": "npm install --prefix web",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "metadata:generate": "npm run generate:all --prefix metadata",
    "metadata:sync": "npm run sync-web --prefix metadata",
    "metadata:preview": "npm run preview --prefix metadata",
    "install:all": "npm run contracts:install && npm run web:install"
  }
}
